{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "01_request.json – step 1 output (AI: understand the question)",
  "type": "object",
  "required": ["run_id", "question", "language", "question_type", "pollutant", "area", "periods", "clarification_needed"],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "pattern": "^P-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}$"},
    "question": {"type": "string", "description": "The resident's question, verbatim"},
    "language": {"type": "string", "enum": ["nl", "en"]},
    "question_type": {"type": "string", "enum": ["education", "temporal_comparison", "location", "trend", "anomaly", "pattern", "threshold", "reference_comparison", "source_investigation", "forecast"]},
    "recipe": {"type": "string", "pattern": "^R[0-9]+$"},
    "pollutant": {"type": "string", "enum": ["pm1", "pm25", "pm10", "no2"]},
    "area": {
      "type": "object",
      "required": ["lat", "lon", "radius_km"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "postcode": {"type": "string"},
        "lat": {"type": "number", "minimum": 50.7, "maximum": 53.6},
        "lon": {"type": "number", "minimum": 3.3, "maximum": 7.3},
        "radius_km": {"type": "number", "minimum": 0.1, "maximum": 10}
      }
    },
    "periods": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["label", "start", "end"], "additionalProperties": false,
        "properties": {"label": {"type": "string"}, "start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}}
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "clarification_needed": {"type": "boolean"},
    "clarification_question": {"type": "string"}
  }
}
