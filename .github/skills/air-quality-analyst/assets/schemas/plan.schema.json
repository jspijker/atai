{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analysis plan",
  "description": "The plan the AI writes in step 2 and R executes after the resident approves it. R rejects any plan that does not match this schema or uses a tool not listed in references/functions.md.",
  "type": "object",
  "required": ["plan_id", "question_type", "pollutant", "area", "periods", "steps", "approved_by_resident"],
  "properties": {
    "plan_id": {"type": "string", "description": "Unique ID, also used as run ID in the audit log"},
    "question_type": {
      "type": "string",
      "enum": ["education", "temporal_comparison", "location", "trend", "anomaly", "pattern", "threshold", "reference_comparison", "source_investigation", "forecast"]
    },
    "recipe": {"type": "string", "pattern": "^R[0-9]+$"},
    "pollutant": {"type": "string", "enum": ["pm1", "pm25", "pm10", "no2"]},
    "area": {
      "type": "object",
      "properties": {
        "postcode": {"type": "string"},
        "lat": {"type": "number", "description": "Centre latitude of the area (the AI fills this from the postcode when it writes the plan; R needs it to select sensors by radius)"},
        "lon": {"type": "number", "description": "Centre longitude of the area"},
        "radius_km": {"type": "number", "minimum": 0.1, "maximum": 10},
        "sensor_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "properties": {
          "label": {"type": "string"},
          "start": {"type": "string", "format": "date"},
          "end": {"type": "string", "format": "date"}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}, "description": "Defaults the AI filled in; shown to the resident"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool"],
        "properties": {
          "tool": {"type": "string", "description": "Must be a tool name from references/functions.md"},
          "tier": {"type": "integer", "enum": [1, 2]},
          "params": {"type": "object", "description": "Tool-specific settings, checked by R against the tool definition"}
        }
      }
    },
    "approved_by_resident": {"type": "boolean"}
  }
}
